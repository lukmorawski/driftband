# Driftband settings. Copy to .env (docker compose reads it automatically).
# Every setting is explained in docs/CONFIGURATION.md.

# Postgres password used by both containers (required).
# Generate with: openssl rand -hex 24
DB_PASSWORD=

# 32-byte key (hex or base64) that encrypts notification channels and
# two-factor secrets. Keep it: without it they cannot be read.
# Generate with: openssl rand -hex 32. Set it before adding channels.
SECRET_KEY=

# Public URL of this instance (https://...), linked from notifications.
# Security keys and passkeys are bound to it: set it when a reverse proxy
# is in front, and do not change it later (enrolled keys stop working).
APP_URL=

# Reverse proxies whose X-Forwarded-For / -Proto headers are trusted
# (comma-separated CIDRs or addresses). Empty = loopback and private ranges.
# Behind a CDN such as Cloudflare, add its published ranges as well.
TRUSTED_PROXIES=

# Cloudflare Turnstile on the sign-in, organization and invitation forms.
# Off by default. yes needs both keys of a Turnstile widget created for
# this instance's host name in the Cloudflare dashboard; the server must be
# able to reach challenges.cloudflare.com. See docs/CONFIGURATION.md.
TURNSTILE_ENABLE=no
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Limits for a public demo instance: yes = at most 10 hosts per organization
# (a platform administrator can change this per organization or exempt it),
# probe interval of at least 60 s and packets of at most 56 bytes.
# no (or leaving it empty) turns the limits off.
TEST_INSTANCE=no
